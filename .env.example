# Backend API (homepage, games, etc.)
# Dev default port: see mall-back/config.dev.toml (e.g. 46002)
NUXT_PUBLIC_API_BASE_URL=devapi.88224646ba.shop

# Supabase Auth（邮箱 / 匿名 / Google OAuth 共用）
# Google 登录不需要额外 NUXT_PUBLIC_GOOGLE_*；在 Supabase Dashboard 启用 Google Provider 即可。
# 配置与验收步骤见 docs/auth-google-login.md
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Turnstile CAPTCHA (optional)
NUXT_PUBLIC_CAPTCHA_ENABLED=false
NUXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
